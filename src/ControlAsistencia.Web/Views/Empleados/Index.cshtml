@model ControlAsistencia.Web.Models.EmpleadoIndexViewModel

@{
    ViewData["Title"] = "Empleados";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0">Empleados</h1>
        <div class="d-flex align-items-center gap-2">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Buscar por nombre..." maxlength="100" aria-label="Buscar por nombre" />
                <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
            </form>
            <a asp-action="Create" class="btn btn-primary">Nuevo empleado</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>DNI</th>
                        <th>Nombre</th>
                        <th>Área/Ubic.</th>
                        <th>Fotografía</th>
                        <th>Perfil Equipo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Empleados.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted">No existen empleados registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Empleados)
                        {
                            <tr>
                                <td>@item.BadgeNumber</td>
                                <td>@item.Ssn</td>
                                <td>@item.Name</td>
                                <td>@item.DepartmentName</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.PhotoBase64))
                                    {
                                        <img src="@item.PhotoBase64" alt="Foto" class="img-thumbnail" style="max-height: 60px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin foto</span>
                                    }
                                </td>
                                <td>@item.PrivilegeDescription</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-outline-primary">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-outline-danger">Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de empleados">
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@Model.Search">Anterior</a></li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : null)"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search">@i</a></li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@Model.Search">Siguiente</a></li>
                </ul>
            </nav>
        }
    </div>
</div>