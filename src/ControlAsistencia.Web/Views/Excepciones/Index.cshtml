@model IEnumerable<ControlAsistencia.Web.Models.ExcepcionDTO>
@{
    ViewData["Title"] = "Permisos y Justificaciones";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Permisos y Justificaciones</h5>
        <div class="d-flex align-items-center gap-2">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Buscar por nombre..." maxlength="100" aria-label="Buscar por nombre" />
                <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
            </form>
            <a class="btn btn-primary btn-sm" asp-action="Create">Nuevo</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead><tr><th>Nombre</th><th>Cantidad Equiv.</th><th>Unidad de Medida</th><th>Abreviatura</th><th>Excepción Normal</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.LeaveName</td>
                        <td>@item.MinUnit.ToString("0.00")</td>
                        <td>@(item.Unit == 1 ? "Hora" : item.Unit == 2 ? "Minuto" : "Día")</td>
                        <td>@item.ReportSymbol</td>
                        <td>@(item.Classify ? "SI" : "NO")</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.LeaveId">Editar</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.LeaveId">Eliminar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        @{
            var currentPage = (int)(ViewBag.CurrentPage ?? 1);
            var totalPages = (int)(ViewBag.TotalPages ?? 1);
        }
        <nav><ul class="pagination mb-0">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewBag.Search">Anterior</a></li>
            <li class="page-item disabled"><span class="page-link">@currentPage / @totalPages</span></li>
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewBag.Search">Siguiente</a></li>
        </ul></nav>
    </div>
</div>