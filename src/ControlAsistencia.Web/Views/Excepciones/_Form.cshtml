@model ControlAsistencia.Web.Models.ExcepcionDTO
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="LeaveId" />
<div class="mb-3">
    <label asp-for="LeaveName" class="form-label">Nombre <span class="text-danger">*</span></label>
    <input asp-for="LeaveName" class="form-control" />
    <span asp-validation-for="LeaveName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="MinUnit" class="form-label">Cantidad Equiv. <span class="text-danger">*</span></label>
    <input asp-for="MinUnit" class="form-control" type="number" step="0.01" min="0.10" max="60.00" />
    <span asp-validation-for="MinUnit" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Unit" class="form-label">Unidad de Medida <span class="text-danger">*</span></label>
    <select asp-for="Unit" class="form-select">
        <option value="1">Hora</option>
        <option value="2">Minuto</option>
        <option value="3">Día</option>
    </select>
    <span asp-validation-for="Unit" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ReportSymbol" class="form-label">Abreviatura <span class="text-danger">*</span></label>
    <input asp-for="ReportSymbol" class="form-control" />
    <span asp-validation-for="ReportSymbol" class="text-danger"></span>
</div>
<div class="form-check mb-3">
    <input asp-for="Classify" class="form-check-input" />
    <label asp-for="Classify" class="form-check-label">Normal <span class="text-danger">*</span></label>
</div>