@model ControlAsistencia.Web.Models.HorarioIndexViewModel

@{
    ViewData["Title"] = "Horarios";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0">Horarios</h1>
        <a asp-action="Create" class="btn btn-primary">Nuevo horario</a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Hora de Entrada</th>
                        <th>Hora de Salida</th>
                        <th>Tolerancia Entrada</th>
                        <th>Tolerancia Salida</th>
                        <th>Color</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Horarios.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted">No existen horarios registrados.</td></tr>
                }
                else
                {
                    foreach (var item in Model.Horarios)
                    {
                        <tr>
                            <td>@item.SchName</td>
                            <td>@item.StartTime?.ToString(@"hh\:mm")</td>
                            <td>@item.EndTime?.ToString(@"hh\:mm")</td>
                            <td>@item.LateMinutes</td>
                            <td>@item.EarlyMinutes</td>
                            <td>
                                <span class="d-inline-block border rounded" title="@item.Color" style="width: 24px; height: 24px; background-color: @GetColor(item.Color);"></span>
                                <span class="ms-2">@item.Color</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.SchClassid" class="btn btn-outline-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.SchClassid" class="btn btn-outline-danger">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de horarios">
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Anterior</a></li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : null)"><a class="page-link" asp-action="Index" asp-route-page="@i">@i</a></li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Siguiente</a></li>
                </ul>
            </nav>
        }
    </div>
</div>

@functions {
    private static string GetColor(int? color) => color switch
    {
        255 => "#ff0000",
        65535 => "#ffff00",
        16715535 => "#0000ff",
        16776960 => "#00ffff",
        65280 => "#00ff00",
        16753920 => "#ffa500",
        8388736 => "#800080",
        16777215 => "#ffffff",
        52377 => "#ccff00",
        8388608 => "#800000",
        11141120 => "#9932cc",
        _ => "#cccccc"
    };
}