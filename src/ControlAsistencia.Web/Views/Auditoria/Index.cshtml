@model ControlAsistencia.Web.Models.AuditoriaIndexViewModel
@{
    ViewData["Title"] = "Auditoría";
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0">Auditoría</h1>

            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text"
                       name="search"
                       value="@Model.Search"
                       class="form-control form-control-sm"
                       placeholder="Buscar operador o descripción..."
                       maxlength="50"
                       aria-label="Buscar operador o descripción" />
                <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
            </form>
        </div>

        <div class="card-body">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success">@successMessage</div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">
                    Total de registros: <strong>@Model.TotalRecords</strong>
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha/Hora de Auditoría</th>
                            <th>Operador</th>
                            <th>Computadora</th>
                            <th>Descripción de Auditoría</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                No se encontraron registros de auditoría
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @(item.LogTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? string.Empty)
                                </td>
                                <td>@(item.Operator ?? string.Empty)</td>
                                <td>@(item.MachineAlias ?? string.Empty)</td>
                                <td>@(item.LogDescr ?? string.Empty)</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginación de auditoría">
                    <ul class="pagination justify-content-end mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber - 1)"
                               asp-route-search="@Model.Search">Anterior</a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : null)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@Model.Search">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber + 1)"
                               asp-route-search="@Model.Search">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
