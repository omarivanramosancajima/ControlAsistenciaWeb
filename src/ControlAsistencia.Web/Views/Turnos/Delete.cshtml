@model ControlAsistencia.Web.Models.DeleteTurnoViewModel
@{ ViewData["Title"] = "Eliminar turno"; }

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white"><h1 class="h4 mb-0">Eliminar turno</h1></div>
    <div class="card-body">
        <p class="alert alert-warning">Revise la información antes de confirmar la eliminación.</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Turno.NAME</dd>
            <dt class="col-sm-3">Fecha de Inicio</dt><dd class="col-sm-9">@Model.Turno.STARTDATE?.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Fecha Fin</dt><dd class="col-sm-9">@Model.Turno.ENDDATE?.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Frecuencia</dt><dd class="col-sm-9">@GetUnitsText(Model.Turno.UNITS)</dd>
            <dt class="col-sm-3">Ciclos</dt><dd class="col-sm-9">@Model.Turno.CYLE</dd>
        </dl>
        <form asp-action="DeleteConfirmed" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="numRunid" value="@Model.Turno.NUM_RUNID" />
            <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@functions {
    private static string GetUnitsText(int? units) => units switch
    {
        0 => "Diario",
        1 => "Semanal",
        2 => "Mensual",
        3 => "Quincenal",
        _ => ""
    };
}