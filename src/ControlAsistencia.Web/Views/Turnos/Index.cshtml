@model ControlAsistencia.Web.Models.TurnoIndexViewModel

@{ ViewData["Title"] = "Turnos"; }

<div class="card" shadow-sm>
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0">Turnos</h1>
        <div class="d-flex align-items-center gap-2">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Buscar por nombre..." maxlength="100" aria-label="Buscar por nombre" />
                <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
            </form>
            <a asp-action="Create" class="btn btn-primary">Nuevo turno</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
        @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Fecha de Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Frecuencia</th>
                        <th>Ciclos</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Turnos.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted">No existen turnos registrados.</td></tr>
                }
                else
                {
                    foreach (var item in Model.Turnos)
                    {
                        <tr>
                            <td>@item.NAME</td>
                            <td>@item.STARTDATE?.ToString("dd/MM/yyyy")</td>
                            <td>@item.ENDDATE?.ToString("dd/MM/yyyy")</td>
                            <td>@GetUnitsText(item.UNITS)</td>
                            <td>@item.CYLE</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.NUM_RUNID" class="btn btn-outline-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.NUM_RUNID" class="btn btn-outline-danger">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de turnos">
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@Model.Search">Anterior</a></li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : null)"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search">@i</a></li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@Model.Search">Siguiente</a></li>
                </ul>
            </nav>
        }
    </div>
</div>

@functions {
    private static string GetUnitsText(int? units) => units switch
    {
        0 => "Diario",
        1 => "Semanal",
        2 => "Mensual",
        3 => "Quincenal",
        _ => ""
    };
}