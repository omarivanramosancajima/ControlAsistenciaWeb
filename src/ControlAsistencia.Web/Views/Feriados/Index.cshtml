@model IReadOnlyList<ControlAsistencia.Web.Models.FeriadoDTO>
@{
    ViewData["Title"] = "Feriados";
}

<div class="card" shadow-sm>
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0">Feriados</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Feriado
        </a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
<!--
        <div class="mb-3">
        </div>
//-->
        <table class="table table-striped table-hover align-middle">
            <thead >
                <tr>
                    <th>Nombre día Festivo</th>
                    <th>Fecha de Feriado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted">No existen feriados registrados.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.HolidayName</td>
                            <td>@item.StartTime.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.HolidayId" class="btn btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.HolidayId" class="btn btn-outline-danger">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Paginación de feriados">
                <ul class="pagination justify-content-end mb-0">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Anterior</a>
                        </li>
                    }
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Siguiente</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>