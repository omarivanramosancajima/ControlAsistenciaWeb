@model ControlAsistencia.Web.Models.FeriadoDTO 
@{ ViewData["Title"] = "Eliminar Feriado"; }

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white"><h1 class="h4 mb-0">Eliminar Feriado</h1></div>
    <div class="card-body">
        <p class="alert alert-warning">Revise la información antes de confirmar la eliminación.</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre Día Festivo</dt><dd class="col-sm-9">@Model.HolidayName</dd>
            <dt class="col-sm-3">Fecha de Feriado</dt><dd class="col-sm-9">@Model.StartTime.ToString("dd/MM/yyyy")</dd>
        </dl>
        <form asp-action="DeleteConfirmed" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.HolidayId" />
            <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

