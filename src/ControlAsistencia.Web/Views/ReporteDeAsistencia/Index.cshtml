@model ControlAsistencia.Web.Models.AttendanceReportIndexViewModel

@{
    ViewData["Title"] = "Reporte de Asistencia";
    var hasValidationMessage = !string.IsNullOrWhiteSpace(Model.ValidationMessage);
}

<div class="card shadow-sm attendance-report-card">
    <div class="card-header attendance-report-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            @if (Model.Estado=="FALTAS")
            {<h1 class="h4 mb-1">Reporte de Faltas</h1>}
            else if (Model.Estado=="TARDANZAS")
            {<h1 class="h4 mb-1">Reporte de Tardanzas</h1>}
            else if (Model.Estado=="SALIDAS TEMPRANAS")
            {<h1 class="h4 mb-1">Reporte de Salidas Tempranas</h1>}
            else if (Model.Estado=="PERMISOS/JUSTIFICACIONES")
            {<h1 class="h4 mb-1">Reporte de Permisos/Justificaciones</h1>}
            else if (Model.Estado=="HORAS EXTRA")
            {<h1 class="h4 mb-1">Reporte de Horas Extras</h1>}
            else 
            {<h1 class="h4 mb-1">Reporte de Asistencia MTPE</h1>}
        </div>
        @if (!hasValidationMessage)
        {
            <div class="d-flex flex-wrap gap-2 attendance-report-actions">
            @if (Model.Estado=="FALTAS")
            {
                <a asp-action="ExportarExcelFalta" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-persona="@Model.Persona" asp-route-area="@Model.Area" asp-route-areaDeptId="@Model.AreaDeptId" asp-route-estado="@Model.Estado" class="btn btn-outline-success">Exportar Excel</a>
                <a asp-action="EmitirReporteFalta" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-persona="@Model.Persona" asp-route-area="@Model.Area" asp-route-areaDeptId="@Model.AreaDeptId" asp-route-estado="@Model.Estado" class="btn btn-outline-danger" target="_blank" rel="noopener">Emitir Reporte</a>
            }
            else if (Model.Estado=="TARDANZAS")
            {<h1 class="h4 mb-1">...</h1>}
            else if (Model.Estado=="SALIDAS TEMPRANAS")
            {<h1 class="h4 mb-1">...</h1>}
            else if (Model.Estado=="PERMISOS/JUSTIFICACIONES")
            {<h1 class="h4 mb-1">...</h1>}
            else if (Model.Estado=="HORAS EXTRA")
            {<h1 class="h4 mb-1">...s</h1>}
            else 
            {
                <a asp-action="ExportarExcel" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-persona="@Model.Persona" asp-route-area="@Model.Area" asp-route-areaDeptId="@Model.AreaDeptId" asp-route-estado="@Model.Estado" class="btn btn-outline-success">Exportar Excel</a>
                <a asp-action="EmitirReporte" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-persona="@Model.Persona" asp-route-area="@Model.Area" asp-route-areaDeptId="@Model.AreaDeptId" asp-route-estado="@Model.Estado" class="btn btn-outline-danger" target="_blank" rel="noopener">Emitir Reporte</a>
            }
            </div>
        }
    </div>
    <div class="card-body attendance-report-body">
        <form method="get" class="row g-3 mb-4 attendance-report-filters">
            <div class="col-md-6 col-lg-2">
                <label class="form-label">Fecha Desde</label>
                <input type="date" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-6 col-lg-2">
                <label class="form-label">Fecha Hasta</label>
                <input type="date" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-6 col-lg-2">
                <label class="form-label">Área</label>
                <div class="d-flex gap-2">
                    <input type="hidden" name="areaDeptId" id="areaDeptId" value="@Model.AreaDeptId" />
                    <button type="button"
                            class="btn btn-outline-primary flex-grow-1 text-start"
                            id="areaSelectorButton"
                            data-bs-toggle="modal"
                            data-bs-target="#areaHierarchyModal"
                            aria-label="Seleccionar área">
                        @(string.IsNullOrWhiteSpace(Model.Area) ? "Todas" : Model.Area)
                    </button>
                    @if (Model.AreaDeptId.HasValue)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="clearAreaButton"
                                title="Mostrar todas las áreas"
                                aria-label="Mostrar todas las áreas">×</button>
                    }
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label">Persona</label>
                <select name="persona" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var item in Model.PersonasDisponibles)
                    {
                        if (string.Equals(item, Model.Persona, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>
            <!--
            <div class="col-md-6 col-lg-2">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var item in Model.EstadosDisponibles)
                    {
                        if (string.Equals(item, Model.Estado, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>
            //-->
            <input type="hidden" name="estado" value="@Model.Estado" >
            <div class="col-md-6 col-lg-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
            <!--col-12 d-flex flex-wrap gap-2//-->
            <div class="col-md-6 col-lg-1 d-flex align-items-end">
                <a asp-action="Index" asp-route-fechaDesde="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-estado="@Model.Estado" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
        <div class="modal fade" id="areaHierarchyModal" tabindex="-1" aria-labelledby="areaHierarchyModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="areaHierarchyModalLabel">Seleccionar Área / Ubicación</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="list-group">
                            <button type="button"
                                    class="list-group-item list-group-item-action @(Model.AreaDeptId.HasValue ? string.Empty : "active")"
                                    data-area-dept-id=""
                                    data-area-name="Todas">
                                Todas
                            </button>
                            @foreach (var area in Model.AreasJerarquia)
                            {
                                var isSelected = Model.AreaDeptId.HasValue && Model.AreaDeptId.Value == area.DeptId;
                                <button type="button"
                                        class="list-group-item list-group-item-action @(isSelected ? "active" : string.Empty)"
                                        data-area-dept-id="@area.DeptId"
                                        data-area-name="@area.DeptName">
                                    @for (var level = 0; level < area.Level; level++)
                                    {
                                        <span class="ms-1" aria-hidden="true">&nbsp;</span>
                                    }
                                    @area.DeptName
                                </button>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="attendance-report-meta d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
            <div>
                <div class="text-muted small">Registros: <strong>@Model.TotalRecords</strong> · Página <strong>@Model.PageNumber</strong> de <strong>@Model.TotalPages</strong> · @Model.PageSize registros por página</div>
            </div>
            <div class="attendance-report-legend d-flex flex-wrap gap-2">
                <span class="attendance-legend-item attendance-legend-falta">Falta</span>
                <span class="attendance-legend-item attendance-legend-tardanza">Tardanza</span>
                <span class="attendance-legend-item attendance-legend-salida-temprana">Salida temprana</span>
                <span class="attendance-legend-item attendance-legend-horas-extras">Horas extras</span>
                <span class="attendance-legend-item attendance-legend-excepcion">Excepción</span>
            </div>
        </div>

        @if (hasValidationMessage)
        {
            <div class="alert alert-warning" role="alert">
                @Model.ValidationMessage
            </div>
        }

        @if (!hasValidationMessage)
        {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle attendance-report-table mb-0">
                <thead class="table-light">
                    <tr>
                        <!--
                        <th>Código</th>
                        //-->
                        <th>DNI</th>
                        <th>Personal</th>
                        <!--
                        <th>Área</th>
                        //-->
                        <th>Fecha</th>
                        <th>Horario Asignado</th>
                        <th class="text-center">Entra.</th>
                        <th class="text-center">Salid.</th>
                        <th class="text-center">Falta</th>
                        <th class="text-center">Horas <br/>EFECT.</th>
                        <th class="text-center">Horas <br/>PERM.</th>
                        <th class="text-center">Tarda. <br/>Entra.</th>
                        <th class="text-center">Salida <br/>Temp.</th>
                        <th class="text-center">Horas <br/>Extras</th>
                        <th>Excepción</th>
                        <th>Marcas Intermedias</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="16" class="text-center text-muted py-4">No existen registros para los filtros seleccionados.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Rows)
                    {
                        <tr>
                            <!--
                            <td class="fw-semibold text-nowrap">@item.Codigo</td>
                            //-->
                            <td class="text-nowrap">@item.Dni</td>
                            <td class="attendance-col-personal">@item.Personal</td>
                            <!--
                            <td class="text-nowrap">@item.Area</td>
                            //-->
                            <td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="attendance-col-horario">@item.HorarioAsignado</td>
                            <td class="text-center text-nowrap">@item.Entrada</td>
                            <td class="text-center text-nowrap">@item.Salida</td>
                            <td class="text-center text-nowrap @GetAttendanceCellClass(item, "falta")">@item.Falta</td>
                            <td class="attendance-col-horascalculadas">@item.HorasEfectivas</td>
                            <td class="attendance-col-horascalculadas">@item.HorasDePermanencia</td>
                            <td class="attendance-col-horascalculadas @GetAttendanceCellClass(item, "tardanza")">@item.TardanzaEntrada</td>
                            <td class="attendance-col-horascalculadas @GetAttendanceCellClass(item, "salida-temprana")">@item.SalidaTemprana</td>
                            <td class="attendance-col-horascalculadas @GetAttendanceCellClass(item, "horas-extras")">@item.HorasExtras</td>
                            <td class="attendance-col-excepcion @GetAttendanceCellClass(item, "excepcion")">@item.Excepcion</td>
                            <td class="attendance-col-marcas">@item.MarcasIntermedias</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de reporte de asistencia" class="mt-3">
                <ul class="pagination attendance-report-pagination justify-content-end mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-persona="@Model.Persona" asp-route-area="@Model.Area" asp-route-areaDeptId="@Model.AreaDeptId" asp-route-estado="@Model.Estado">Anterior</a>
                    </li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : null)">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-persona="@Model.Persona" asp-route-area="@Model.Area" asp-route-areaDeptId="@Model.AreaDeptId" asp-route-estado="@Model.Estado">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-persona="@Model.Persona" asp-route-area="@Model.Area" asp-route-areaDeptId="@Model.AreaDeptId" asp-route-estado="@Model.Estado">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
        }
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const form = document.querySelector(".attendance-report-filters");
    const areaDeptId = document.getElementById("areaDeptId");
    const areaSelectorButton = document.getElementById("areaSelectorButton");
    const clearAreaButton = document.getElementById("clearAreaButton");
    const areaHierarchyModal = document.getElementById("areaHierarchyModal");

    if (!form || !areaDeptId || !areaSelectorButton || !areaHierarchyModal) {
        return;
    }

    areaHierarchyModal.querySelectorAll("[data-area-dept-id]").forEach(function (item) {
        item.addEventListener("click", function () {
            areaDeptId.value = this.getAttribute("data-area-dept-id") || "";
            areaSelectorButton.textContent = this.getAttribute("data-area-name") || "Todas";
            form.submit();
        });
    });

    if (clearAreaButton) {
        clearAreaButton.addEventListener("click", function () {
            areaDeptId.value = "";
            form.submit();
        });
    }
});
</script>

@functions {
    private static string GetAttendanceCellClass(AttendanceReportRowViewModel item, string state)
    {
        return state switch
        {
            "falta" when item.Falta == "Si" => "attendance-cell-falta",
            "tardanza" when !string.IsNullOrWhiteSpace(item.TardanzaEntrada) => "attendance-cell-tardanza",
            "salida-temprana" when !string.IsNullOrWhiteSpace(item.SalidaTemprana) => "attendance-cell-salida-temprana",
            "horas-extras" when !string.IsNullOrWhiteSpace(item.HorasExtras) => "attendance-cell-horas-extras",
            "excepcion" when !string.IsNullOrWhiteSpace(item.Excepcion) => "attendance-cell-excepcion",
            _ => string.Empty
        };
    }
}