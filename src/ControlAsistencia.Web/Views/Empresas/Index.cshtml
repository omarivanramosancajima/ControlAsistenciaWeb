@model ControlAsistencia.Web.Models.EmpresaIndexViewModel
@{
    ViewData["Title"] = "Empresas";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0">Empresas</h1>
        <div class="d-flex align-items-center gap-2">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="search" value="@Model.Search"
                       class="form-control form-control-sm"
                       placeholder="Buscar por RUC, razón social o abreviatura..."
                       maxlength="100" aria-label="Buscar empresa" />
                <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                }
            </form>
            <!--
            <a asp-action="Crear" class="btn btn-primary btn-sm">Nueva empresa</a>
            //-->
        </div>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">Total de registros: <strong>@Model.TotalRecords</strong></span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>RUC</th>
                        <th>Razón social</th>
                        <th>Teléfono</th>
                        <th>Móvil</th>
                        <th>Email</th>
                        <th>Abreviatura</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No existen empresas activas que coincidan con la búsqueda.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.TaxId</td>
                            <td>@item.Descrip</td>
                            <td>@(item.Tel ?? "-")</td>
                            <td>@(item.Movil ?? "-")</td>
                            <td>@(item.Email ?? "-")</td>
                            <td>@(item.DeptName ?? "-")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Editar" asp-route-id="@item.CompanyId"
                                       asp-route-search="@Model.Search" asp-route-page="@Model.PageNumber"
                                       class="btn btn-outline-primary">Editar</a>
                                       <!--
                                    <a asp-action="Eliminar" asp-route-id="@item.CompanyId"
                                       asp-route-search="@Model.Search" asp-route-page="@Model.PageNumber"
                                       class="btn btn-outline-danger">Eliminar</a>
                                       //-->
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de empresas">
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@Model.Search">Anterior</a>
                    </li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : null)">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i" asp-route-search="@Model.Search">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@Model.Search">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
