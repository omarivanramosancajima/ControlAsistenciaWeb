@model ControlAsistencia.Web.Models.EmpresaDeleteViewModel
@{
    ViewData["Title"] = "Eliminar empresa";
}

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white">
        <h1 class="h4 mb-0">Eliminar empresa</h1>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            Revise la información antes de confirmar la eliminación.
            La empresa será dada de baja de forma lógica; el nodo de área no será eliminado.
        </div>

        <dl class="row">
            <dt class="col-sm-3">RUC</dt>
            <dd class="col-sm-9">@Model.TaxId</dd>
            <dt class="col-sm-3">Razón social</dt>
            <dd class="col-sm-9">@Model.Descrip</dd>
            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@(Model.Tel ?? "-")</dd>
            <dt class="col-sm-3">Móvil</dt>
            <dd class="col-sm-9">@(Model.Movil ?? "-")</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "-")</dd>
            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@(Model.Direc ?? "-")</dd>
            <dt class="col-sm-3">Abreviatura</dt>
            <dd class="col-sm-9">@(Model.DeptName ?? "-")</dd>
        </dl>

        <form asp-action="EliminarConfirmado" method="post" id="deleteForm" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.CompanyId" />
            <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
            <input type="hidden" name="page" value="@Context.Request.Query["page"]" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" asp-route-search="@Context.Request.Query["search"]"
               asp-route-page="@Context.Request.Query["page"]" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('deleteForm').addEventListener('submit', function (event) {
        if (!window.confirm('¿Está seguro que desea eliminar la empresa?')) {
            event.preventDefault();
        }
    });
</script>
}
