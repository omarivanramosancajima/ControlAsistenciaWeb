<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Asistencia</title>
    <meta name="theme-color" content="#d8895f" />
    <meta name="application-name" content="Control Asistencia" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="~/pwa-icon-192.png?v=2" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ControlAsistencia.Web.styles.css" asp-append-version="true" />
</head>
<body>
