                                    <li><a class="dropdown-item" asp-area="" asp-controller="ResumendeAsistencia" asp-action="Index">Resumen de Asistencia</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Reporte-de-Marcas" asp-action="Index">Reporte de Marcas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Resumen-por-Area" asp-action="Index">Resumen por Área</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Cuadro-de-Asistencia" asp-action="Index">Cuadro de Asistencia</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Conceptos-de-Asistencia" asp-action="Index">Conceptos de Asistencia</a></li>
                                    //-->
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Configuración
                                </a>
                                <ul class="dropdown-menu">
                                    <!--
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Reglas-de-Asistencia" asp-action="Index">Reglas de Asistencia</a></li>
                                    //-->
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Empresas" asp-action="Index">Empresas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AccesoAlSistema" asp-action="Index">Acceso al Sistema</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Auditoria" asp-action="Index">Auditoría</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AcercaDe" asp-action="Index">Acerca De</a></li>
                                    <!--
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Permisos-del-Usuario" asp-action="Index">Permisos del Usuario</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Opciones-del-Sistema" asp-action="Index">Opciones del Sistema</a></li>
                                    //-->
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-muted small" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity?.Name
                                </a>                                
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="CambioDeClave" asp-action="Index">Cambio de Claves</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Cerrar Sesión" asp-action="Index">
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                                        </form>                                    
                                    </a></li>
                                </ul>
                            </li>
                            <!--
                            <span class="text-muted small">@User.Identity?.Name</span>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                            </form>
                            //-->
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Control Asistencia<!-- - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>//-->
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", function () {
                navigator.serviceWorker.register("/service-worker.js").catch(function () {
                    // La aplicación continúa funcionando normalmente si el navegador no permite PWA.
                });
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
