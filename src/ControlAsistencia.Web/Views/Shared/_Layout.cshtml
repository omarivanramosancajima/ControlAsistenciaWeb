                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ProgramarTurno" asp-action="Index">Programar Turno</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="TurnosdelEmpleado" asp-action="Index">Turnos del Empleado</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="JustificarEmpleado" asp-action="Index">Justificar Empleado</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="MarcacionEmpleado" asp-action="Index">Marcación del Personal</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ReubicacionEmpleado" asp-action="Index">Reubicación del Personal</a></li>
                                    <!--
s                                    <li><a class="dropdown-item" asp-area="" asp-controller="Distribución-del-Personal" asp-action="Index">Distribución del Personal</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Autorización-de-HE" asp-action="Index">Autorización de H.E.</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Conceptos-de-Asistencia" asp-action="Index">Conceptos de Asistencia</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="LaborFortuitadelEmpleado" asp-action="Index">Labor Fortuita del Empleado</a></li>
                                    //-->
                                </ul>
                            </li>
                            <!--
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Equipamiento de Asistencia
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Configuracion" asp-action="Index">Configuración</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Equipos" asp-action="Index">Equipos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Enrolamiento" asp-action="Index">Enrolamiento</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Comunicacion" asp-action="Index">Comunicación</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Importacion" asp-action="Index">Importación</a></li>
                                </ul>
                            </li>
                            //-->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Cálculos y Reportes
                                </a>
                                <ul class="dropdown-menu">
                                    <!--
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Visor-de-Asistencias" asp-action="Index">Visor de Asistencias</a></li>                                    
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Turnos-y-Horarios" asp-action="Index">Turnos y Horarios</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="EntradasySalidas" asp-action="Index">Entradas y Salidas</a></li>
                                    //-->
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ReportedeAsistencia" asp-action="Index" asp-route-fechaDesde="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@DateTime.Now.ToString("yyyy-MM-dd")">Reporte de Asistencia MTPE</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ReportedeAsistencia" asp-action="Index" asp-route-fechaDesde="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-estado="TARDANZAS">Reporte de Tardanzas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ReportedeAsistencia" asp-action="Index" asp-route-fechaDesde="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-estado="SALIDAS TEMPRANAS">Reporte de Salidas Tempranas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ReportedeAsistencia" asp-action="Index" asp-route-fechaDesde="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-estado="FALTAS">Reporte de Faltas</a></li>
