@model ControlAsistencia.Web.Models.UsuarioLoginDTO
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container-fluid px-3 px-md-4 py-4 py-md-5">
    <div class="row justify-content-center align-items-center min-vh-100 g-0">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-gradient text-white mb-3 login-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16">
                                <path d="M5.072 0C4.708 0 4.5.29 4.5.5v1.035C3.878 1.735 2.248 2.24.5 2.5v3.95c0 2.543 1.875 4.865 4.861 5.946a.5.5 0 0 0 .278 0C8.625 11.315 10.5 8.993 10.5 6.45V2.5c-1.748-.26-3.378-.765-4-1.965V.5c0-.21-.208-.5-.572-.5z"/>
                                <path d="M8 5a1.5 1.5 0 0 0-1.5 1.5V7H6a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-.5v-.5A1.5 1.5 0 0 0 8 5zm.5 2h-1v-.5a.5.5 0 0 1 1 0z"/>
                            </svg>
                        </span>
                        <h1 class="h3 fw-bold mb-2">Bienvenido</h1>
                        <p class="text-muted mb-0">Ingresa tus credenciales para acceder al módulo de asistencia.</p>
                    </div>

                    @if (ViewBag.ErrorMessage is not null)
                    {
                        <div class="alert alert-danger rounded-3" role="alert">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Login" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="BadgeNumber" class="form-label fw-semibold">Código de usuario</label>
                            <input asp-for="BadgeNumber" class="form-control form-control-lg rounded-3" placeholder="Ejemplo: 1001" autocomplete="username" />
                            <span asp-validation-for="BadgeNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" placeholder="••••••••" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-semibold">
                                Iniciar sesión
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}