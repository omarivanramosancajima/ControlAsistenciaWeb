@model ControlAsistencia.Web.Models.MarcacionEmpleadoDeleteConfirmViewModel

<div class="modal fade" id="confirmDeleteMarcacionesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación de marcaciones</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="deleteMarcacionesMessage" class="alert d-none"></div>

                <div class="mb-3">
                    <strong>DNI:</strong> @Model.Ssn
                    <br />
                    <strong>Persona:</strong> @Model.EmployeeName
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha de Marcaje</th>
                                <th>Tipo de Marcaje</th>
                                <th>Tipo Registro</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.CheckTime.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.CheckType</td>
                                <td>@item.RecordType</td>
                                <td>@item.Reason</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-warning mb-0">
                    ¿Confirma que desea borrar físicamente las marcaciones seleccionadas?
                    La operación quedará registrada en CHECKEXACT.
                </div>

                <div class="border rounded p-3 mt-3 d-none" id="deleteMarcacionesProgressBox">
                    <h6 class="mb-3">Procesando eliminación</h6>
                    <div id="deleteMarcacionesProgressContent" class="small text-muted"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteMarcacionesButton">
                    Confirmar Borrado
                </button>
            </div>
        </div>
    </div>
</div>